# Port to listen on (default: 8080)
PORT=8080

# Required: Upstream webhook URL to forward requests to
# For OpenBot, this is the routine webhook URL from the routine editor.
UPSTREAM_URL=https://example.com/webhook

# Optional: Bearer token for upstream authentication (ignored when OpenBot signing is on)
UPSTREAM_BEARER=

# Optional: Full Authorization header value for upstream (overrides UPSTREAM_BEARER;
# ignored when OpenBot signing is on)
# Example: UPSTREAM_AUTH_HEADER=Basic dXNlcjpwYXNz
UPSTREAM_AUTH_HEADER=

# Optional: OpenBot routine signing secret (whsec_…). When set, the bridge wraps the
# converted payload in OpenBot's event envelope and adds X-OpenBot-* signature headers.
# Docs: https://github.com/nightly-labs/openbot/blob/main/docs/webhooks.md
OPENBOT_WEBHOOK_SECRET=

# Optional: OpenBot event `type` field when signing (default: pebble.transcription).
# Must match the routine's configured event type if the routine filters by type.
OPENBOT_EVENT_TYPE=pebble.transcription

# Optional: Shared secret for incoming request authentication
# If set, clients must send X-Bridge-Token header or Authorization: Bearer <secret>
SHARED_SECRET=
